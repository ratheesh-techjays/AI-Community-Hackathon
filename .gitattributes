# Normalise to LF in the repo; check out native on Windows.
* text=auto eol=lf

*.png binary
*.jpg binary
*.tif binary
*.pbf binary
*.geojson text eol=lf

# Generated -- exclude from diffs and language stats.
web/src/api/generated/** linguist-generated=true
web/package-lock.json linguist-generated=true -diff
