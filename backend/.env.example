# ---- Core ----
PRAHARI_ENV=local
PRAHARI_CONFIG_VERSION=v1

# ---- Gemini ----
# Get a key at https://aistudio.google.com/apikey
# IMPORTANT: verify live rate limits at https://aistudio.google.com/rate-limit
# Pro models were removed from the free tier on 2026-04-01. Use Flash tier only.
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACT=gemini-2.5-flash
GEMINI_MODEL_NARRATE=gemini-2.5-flash
GEMINI_MODEL_QUERY=gemini-2.5-flash
ENABLE_AI=true

# ---- Earth Engine ----
# Register (immediate, no billing for noncommercial):
#   https://code.earthengine.google.com/register?project=YOUR_PROJECT
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_KEY_PATH=

# ---- Storage ----
GCS_BUCKET=prahari-artifacts
DATABASE_URL=postgresql+psycopg://prahari:prahari@localhost:5432/prahari
