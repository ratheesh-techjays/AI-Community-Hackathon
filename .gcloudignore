# gcloud run deploy --source . uploads this context. Without this file gcloud
# falls back to .gitignore, which would drop data/raw/ibtracs_NI.csv (needed
# for on-demand runs). Mirror .dockerignore instead.
.gcloudignore
.git
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
web
docs
.playwright-mcp
backend/tests
**/.env
**/*service-account*.json
**/gee-key*.json
