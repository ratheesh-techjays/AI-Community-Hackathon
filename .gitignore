# --- Large / regenerable data -------------------------------------------------
# IBTrACS is 27.9 MB and fetchable by URL. Get it with `make data`.
data/raw/ibtracs_NI.csv
data/raw/*.osm.pbf
data/raw/*.tif
data/golden/*.tif

# NOTE: data/raw/osdma_shelters.{csv,geojson} IS committed on purpose.
# It was extracted from an embedded JS array on the OSDMA site and is not
# re-fetchable by a plain URL request. Losing it means redoing the scrape.

