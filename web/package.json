{
  "name": "prahari-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript http://localhost:8080/api/v1/openapi.json -o src/api/generated/schema.d.ts",
    "api:check": "npm run api:types && git diff --exit-code src/api/generated/schema.d.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@vanilla-extract/css": "^1.16.0",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/sprinkles": "^1.6.3",
    "deck.gl": "^9.0.0",
    "i18next": "^23.16.0",
    "maplibre-gl": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.59.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vanilla-extract/vite-plugin": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.14.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "msw": "^2.6.0",
    "openapi-typescript": "^7.4.0",
    "stylelint": "^16.10.0",
    "stylelint-declaration-strict-value": "^1.10.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  }
}
